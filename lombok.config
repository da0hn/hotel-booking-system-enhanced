# Este arquivo existe por uma razão só, e ela não é opcional: sem ele o
# `@Jacksonized` das classes de evento do `commons` gera anotações do Jackson 2
# e a compilação quebra em `package com.fasterxml.jackson.databind.annotation
# does not exist`.
#
# O Lombok erra o palpite sozinho porque o Jackson 3 continua usando o
# `jackson-annotations` 2.x — ver `com.fasterxml.jackson.annotation` no
# classpath o convence de que o Jackson 2 está presente, e na dúvida ele fica
# com o 2 e emite um aviso de ambiguidade.
#
# A chave é de LISTA: com `=` no lugar de `+=` ela é ignorada em silêncio, e o
# sintoma é idêntico ao de não ter arquivo nenhum.
config.stopBubbling = true
lombok.jacksonized.jacksonVersion += 3
