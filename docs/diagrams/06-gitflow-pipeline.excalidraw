    {
      "type": "text", "id": "regras_corpo",
      "x": 362, "y": 456, "width": 500, "height": 128,
      "text": "master e develop só recebem merge por Pull Request.\n\nfeature/* nunca vai direto para a master; release/* e\nhotfix/* são as únicas portas de entrada.\n\nTodo push na master abre um PR de volta para a develop,\nsenão a correção some no próximo corte de release.",
      "originalText": "master e develop só recebem merge por Pull Request.\n\nfeature/* nunca vai direto para a master; release/* e\nhotfix/* são as únicas portas de entrada.\n\nTodo push na master abre um PR de volta para a develop,\nsenão a correção some no próximo corte de release.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500005, "version": 1, "versionNonce": 500006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },

