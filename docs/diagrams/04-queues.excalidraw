  {
   "type": "text",
   "id": "foot_title",
   "x": 100,
   "y": 976,
   "width": 900,
   "height": 24,
   "text": "O que não existe nesta topologia",
   "originalText": "O que não existe nesta topologia",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 320123,
   "version": 1,
   "versionNonce": 320124,
   "isDeleted": false,
